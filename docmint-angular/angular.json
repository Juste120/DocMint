{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "docmint-angular": {
      "projectType": "library",
      "root": "projects/docmint-angular",
      "sourceRoot": "projects/docmint-angular/src",
      "architect": {
        "build": {
          "builder": "@angular/build:ng-packagr",
          "options": {
            "project": "projects/docmint-angular/ng-package.json",
            "tsConfig": "projects/docmint-angular/tsconfig.lib.json"
          }
        }
      }
    }
  }
}
