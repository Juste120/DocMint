<?xml version="1.0" encoding="UTF-8"?>
<!-- SpotBugs exclusions. Every entry must be justified. -->
<FindBugsFilter>
  <!-- Records and immutable value types expose defensive copies or unmodifiable views;
       EI_EXPOSE_REP findings on Spring-managed beans and properties are false positives. -->
  <Match>
    <Package name="~io\.github\.juste120\.docmint\.spring.*"/>
    <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
  </Match>
  <!-- Protection is deliberately shared, not copied: the caller wipes the passwords with
       Protection.clear(); a defensive copy would leave an unwiped copy in memory. -->
  <Match>
    <Or>
      <Class name="io.github.juste120.docmint.api.RenderOptions"/>
      <Class name="io.github.juste120.docmint.domain.DocumentOptions"/>
    </Or>
    <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
  </Match>
  <!-- Post-processors hold their strategy (an injected, stateless TableWriter service). -->
  <Match>
    <Class name="io.github.juste120.docmint.infrastructure.export.TablePostProcessor"/>
    <Bug pattern="EI_EXPOSE_REP2"/>
  </Match>
  <!-- Demo application is never published. -->
  <Match>
    <Package name="~io\.github\.juste120\.docmint\.demo.*"/>
  </Match>
</FindBugsFilter>
